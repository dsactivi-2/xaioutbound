# Copy this file to `.env` and fill in the secrets.
#
# IMPORTANT:
# - Do not commit `.env` to git.
# - `PUBLIC_BASE_URL` must be public HTTPS (Telnyx must reach it).

### Server
PORT=3000
PUBLIC_BASE_URL=https://agent.example.com

# Protect `/telnyx/call` (required)
ADMIN_API_KEY=PLEASE_GENERATE_A_LONG_RANDOM_VALUE

### Telnyx (Outbound dialing)
TELNYX_API_KEY=FILL_ME
TELNYX_CONNECTION_ID=FILL_ME
TELNYX_FROM_NUMBER=+49123456789
TELNYX_SIP_REGION=Europe

### xAI (Voice)
XAI_API_KEY=FILL_ME
XAI_MODEL=grok-voice-think-fast-1.0
XAI_VOICE=ara

### Agent settings
AGENT_COMPANY_NAME=DEINE_FIRMA
AGENT_PRODUCT_NAME=Jobanzeigen/Inserate auf StepStone & Indeed
AGENT_TARGET_MARKET=HR/Recruiting-Verantwortliche

### Limits (optional)
MAX_CONCURRENT_CALLS=20
STREAM_TOKEN_TTL_SECONDS=600

