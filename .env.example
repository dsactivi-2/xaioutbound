PORT=3000
PUBLIC_BASE_URL=https://your-public-url.example

# Telnyx (optional, for outbound dialing via Call Control)
TELNYX_API_KEY=your_telnyx_api_key
TELNYX_CONNECTION_ID=your_connection_id
TELNYX_FROM_NUMBER=+15551234567

# xAI
XAI_API_KEY=your_xai_api_key
XAI_MODEL=grok-voice-think-fast-1.0
XAI_VOICE=eve

# Optional: basic safety / behavior knobs
AGENT_COMPANY_NAME=Acme Inc
AGENT_PRODUCT_NAME=Acme Offer
AGENT_TARGET_MARKET=small businesses
